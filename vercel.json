{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    { "src": "api/tariffs.js", "use": "@vercel/node" },
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/tariffs", "dest": "api/tariffs.js" },
    { "src": "/foto", "dest": "/foto.html" },
    { "src": "/video", "dest": "/video.html" },
    { "src": "/image", "dest": "/image.html" },
    { "src": "/cards-template", "dest": "/cards-template.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
